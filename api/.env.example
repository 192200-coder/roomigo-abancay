# Copia este archivo como api/.env y completa los valores. api/.env NO se sube a git.
# Spring Boot y docker compose lo leen automáticamente al ejecutar desde la carpeta api/.

# --- Base de datos (PostgreSQL local con docker compose, o Supabase) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/roomix_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- Seguridad ---
# Clave Base64 de al menos 32 bytes. En PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
APP_JWT_SECRET=

# --- Administrador inicial (obligatorio la primera vez que arranca) ---
APP_ADMIN_INITIAL_EMAIL=admin@roomix.com
APP_ADMIN_INITIAL_PASSWORD=

# --- Correo (opcional en local) ---
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# --- Mercado Pago (Fase 3) ---
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=
