# Copia este archivo como api/.env y completa los valores. api/.env NO se sube a git.
# Spring Boot y docker compose lo leen automáticamente al ejecutar desde la carpeta api/.

# --- Base de datos (PostgreSQL local con docker compose, o Supabase) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/roomix_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- Seguridad ---
# Clave Base64 de al menos 32 bytes. En PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
APP_JWT_SECRET=

# --- Administrador inicial (obligatorio la primera vez que arranca) ---
APP_ADMIN_INITIAL_EMAIL=admin@roomix.com
APP_ADMIN_INITIAL_PASSWORD=

# --- Correo (opcional en local) ---
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# --- Mercado Pago (Checkout Pro) ---
# Sin MP_ACCESS_TOKEN los pagos quedan deshabilitados (los endpoints responden 503).
# Para desarrollar usa las credenciales de una CUENTA VENDEDORA DE PRUEBA (Perú).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones > tu aplicación > Webhooks). Valida la firma x-signature.
MP_WEBHOOK_SECRET=
# URL pública del FRONTEND: Mercado Pago devuelve aquí al comprador (/?pago=resultado).
#   Local con túnel:  https://<tu-dominio>.ngrok-free.dev   (ngrok http --url=<tu-dominio>.ngrok-free.dev 4200)
#   Producción:       https://<tu-app>.vercel.app
MP_BACK_URL_BASE=http://localhost:4200
# URL pública del webhook (solo HTTPS). Con el túnel, pasa por el proxy de ng serve hacia el backend.
#   https://<tu-dominio>.ngrok-free.dev/api/v1/payments/mercadopago/webhook
MP_WEBHOOK_URL=
